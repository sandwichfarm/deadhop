{
  "name": "@deadhop/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 and Svelte 4 components for deadhop bitcoin payments: PayButton, InvoiceForm, Invoice and a headless checkout.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandwichfarm/deadhop.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/sandwichfarm/deadhop/tree/main/packages/svelte#readme",
  "bugs": "https://github.com/sandwichfarm/deadhop/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "svelte": "./dist/svelte5/index.js",
  "exports": {
    ".": {
      "types": "./dist/svelte5/index.d.ts",
      "svelte": "./dist/svelte5/index.js",
      "default": "./dist/svelte5/index.js"
    },
    "./svelte4": {
      "types": "./dist/svelte4/index.d.ts",
      "svelte": "./dist/svelte4/index.js",
      "default": "./dist/svelte4/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "bitcoin",
    "invoice",
    "payments",
    "nostr",
    "contextvm",
    "svelte",
    "svelte5",
    "svelte4"
  ],
  "scripts": {
    "build": "rm -rf dist && svelte-package -i src/svelte5 -o dist/svelte5 && mkdir -p dist/svelte4 && cp src/svelte4/*.svelte src/svelte4/index.js src/svelte4/index.d.ts dist/svelte4/ && cp ../shared/styles.css dist/styles.css",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run --coverage --project svelte && vitest run --project svelte-ssr",
    "test:svelte4": "cd test-svelte4 && npm test",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css . && attw --pack . --profile esm-only --entrypoints . --ignore-rules internal-resolution-error"
  },
  "dependencies": {
    "@deadhop/client": "0.1.0"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "svelte": "^5.58.0",
    "svelte-check": "^4.0.0",
    "svelte2tsx": "^0.7.63",
    "vite": "^8.3.8"
  }
}
