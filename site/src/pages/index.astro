---
import Base from '../layouts/Base.astro';
import { benefits, components, docLinks, limits, pricing, product, steps } from '../content';
import { faq, landingJsonLd } from '../seo';
import { at } from '../paths';
---

<Base
  title={product.title}
  description={product.description}
  path="/"
  markdown="/index.md"
  jsonLd={landingJsonLd(Astro.site!)}
>
  <header class="bar">
    <a class="brand" href={at('/')} aria-label="deadhop home">
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"
        ><circle cx="4.6" cy="20" r="3.1" fill="currentColor"></circle><path
          d="M7.4 16.2C10.5 5 20 2.6 24.5 14.8"
          fill="none"
          stroke="currentColor"
          stroke-width="2.8"
          stroke-linecap="round"
          stroke-dasharray="4.2 3.6"></path><path
          d="M18 18.5H22.3V20.2a1 1 0 0 0 1 1H25.7a1 1 0 0 0 1-1V18.5H31V28.5a1.5 1.5 0 0 1-1.5 1.5H19.5A1.5 1.5 0 0 1 18 28.5Z"
          fill="currentColor"></path></svg
      >
      <span>deadhop</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        <li><a href="#security">Security</a></li>
        <li><a href={at('/docs/')}>Docs</a></li>
        <li><a href={at('/docs/quickstart.html')}>Quick start</a></li>
      </ul>
    </nav>
  </header>

  <main id="content">
    <div class="stage">
      <div class="stage__copy">
        <section class="hero" aria-labelledby="hero-title">
          <p class="stamp">ports open: 0</p>
          <h1 id="hero-title">{product.motto.split(/(?<=\.)\s+/).map((line) => <span class="line">{line}</span>)}</h1>
          <p class="motto-sub">{product.tagline}</p>
          <p class="lede">{product.summary}</p>
          <p class="actions">
            <a class="button button--primary" href={at('/docs/quickstart.html')}>Run it locally</a>
            <a class="button" href={at('/docs/')}>Read the docs</a>
          </p>
        </section>

        <section id="story" aria-label="How a payment flows">
          {
            steps.map((s) => (
              <article class="step" id={s.id} aria-labelledby={`${s.id}-title`}>
                <p class="kicker">{s.kicker}</p>
                <h2 id={`${s.id}-title`}>{s.title}</h2>
                <p>{s.body}</p>
              </article>
            ))
          }
        </section>
      </div>
      <div class="stage__visual" aria-hidden="true">
        <canvas id="scene"></canvas>
      </div>
    </div>

    <section id="security" class="band" aria-labelledby="security-title">
      <h2 id="security-title" data-reveal>Security benefits</h2>
      <ul class="grid" data-stagger>
        {
          benefits.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="band band--narrow" aria-labelledby="limits-title">
      <h2 id="limits-title" data-reveal>What it does not protect against</h2>
      <ul class="plain" data-stagger>{limits.map((l) => <li>{l}</li>)}</ul>
      <p><a href={at('/docs/security.html')}>Full security analysis</a></p>
    </section>

    <section class="band" aria-labelledby="parts-title">
      <h2 id="parts-title" data-reveal>What you run</h2>
      <ul class="parts" data-stagger>
        {
          components.map((c) => (
            <li>
              <h3>{c.name}</h3>
              <p>{c.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="price" id="pricing"><strong>Price:</strong> {pricing}</p>
    </section>

    <section class="band band--narrow" aria-labelledby="faq-title">
      <h2 id="faq-title" data-reveal>Questions</h2>
      <dl class="faq" data-stagger>
        {
          faq.map((f) => (
            <div>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="band" aria-labelledby="docs-title">
      <h2 id="docs-title" data-reveal>Documentation</h2>
      <ul class="cards" data-stagger>
        {
          docLinks.map((d) => (
            <li>
              <a href={at(d.href)}>
                <span class="cards__title">{d.title}</span>
                <span class="cards__body">{d.body}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="foot">
    <p>deadhop 0.1.0</p>
    <nav aria-label="Footer">
      <ul>
        <li><a href={at('/docs/')}>Documentation</a></li>
        <li><a href={at('/docs/security.html')}>Security</a></li>
        <li><a href={at('/index.md')}>This page as Markdown</a></li>
        <li><a href={at('/llms.txt')}>llms.txt</a></li>
      </ul>
    </nav>
  </footer>

  <script>
    import '../scripts/boot';
  </script>
</Base>
